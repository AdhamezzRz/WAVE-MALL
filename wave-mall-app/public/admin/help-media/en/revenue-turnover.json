 "title": "Tenant sales and turnover rent",
 "duration": 69.86,
 "cues": [
  {
   "start": 0.04,
   "end": 7.42,
   "text": "Enter monthly sales, compare tenants, and bill the share of sales above the breakpoint.",
   "step": 0,
   "url": "",
   "intro": true
  },
  {
   "start": 7.42,
   "end": 13.93,
   "text": "Turnover and sales follows what each tenant sells, and the rent they owe on it.",
   "step": 1,
   "url": "/admin/turnover"
  },
  {
   "start": 13.93,
   "end": 19.37,
   "text": "Total sales, sales per square metre, and the rent to sales ratio.",
   "step": 2,
   "url": "/admin/turnover"
  },
  {
   "start": 19.37,
   "end": 24.61,
   "text": "Each month, enter the sales on the Sales tab.",
   "step": 3,
   "url": "/admin/turnover/sales"
  },
  {
   "start": 24.61,
   "end": 29.61,
   "text": "Type the gross sales, the returns and the number of receipts.",
   "step": 4,
   "url": "/admin/turnover/sales"
  },
  {
   "start": 35.58,
   "end": 41.44,
   "text": "Choose Save sales. Tenants can also send them from their portal.",
   "step": 7,
   "url": "/admin/turnover/sales?period=2026-10"
  },
  {
   "start": 41.44,
   "end": 44.79,
   "text": "Then open Billing.",
   "step": 8,
   "url": "/admin/turnover/billing"
  },
  {
   "start": 44.79,
   "end": 53.37,
   "text": "Turnover rent is the sales above the breakpoint, times the agreed percentage. When sales are below it, nothing is owed.",
   "step": 9,
   "url": "/admin/turnover/billing"
  },
  {
   "start": 53.37,
   "end": 59.16,
   "text": "Bill each lease, or record nil, so the month is closed.",
   "step": 10,
   "url": "/admin/turnover/billing"
  },
  {
   "start": 59.16,
   "end": 65.16,
   "text": "Billed months move down. On the overview, the ranking compares every tenant's sales.",
   "step": 11,
   "url": "/admin/turnover/billing"
  }
 ],
