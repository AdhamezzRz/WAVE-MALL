 "title": "Turning a request into a purchase order",
 "duration": 58.15,
 "cues": [
  {
   "start": 0.26,
   "end": 7.65,
   "text": "From an approved request, create the purchase order, choose the supplier and send it.",
   "step": 0,
   "url": "",
   "intro": true
  },
  {
   "start": 7.65,
   "end": 11.1,
   "text": "Approved requests wait in Approved, to order.",
   "step": 1,
   "url": "/admin/purchasing"
  },
  {
   "start": 11.1,
   "end": 14.52,
   "text": "Open the request.",
   "step": 2,
   "url": "/admin/purchasing/requests/5"
  },
  {
   "start": 14.52,
   "end": 19.96,
   "text": "Its approval history is here. The next step is the purchase order.",
   "step": 3,
   "url": "/admin/purchasing/requests/5"
  },
  {
   "start": 19.96,
   "end": 26.08,
   "text": "Choose Create the purchase order. The lines come from the request.",
   "step": 4,
   "url": "/admin/purchasing/orders/new?request=5"
  },
  {
   "start": 26.08,
   "end": 30.66,
   "text": "Choose the supplier, or type a new one.",
   "step": 5,
   "url": "/admin/purchasing/orders/new?request=5"
  },
  {
   "start": 30.66,
   "end": 37.6,
   "text": "Check the delivery date and the payment terms. Late deliveries are flagged on the purchasing page.",
   "step": 6,
   "url": "/admin/purchasing/orders/new?request=5"
  },
  {
   "start": 37.6,
   "end": 40.94,
   "text": "Put the price the supplier quoted.",
   "step": 7,
   "url": "/admin/purchasing/orders/new?request=5"
  },
  {
   "start": 40.94,
   "end": 49.21,
   "text": "Save and mark as sent. The order has its number and is ready to print or email.",
   "step": 8,
   "url": "/admin/purchasing/orders/6"
  },
  {
   "start": 49.21,
   "end": 53.5,
   "text": "This table follows each line: ordered, received and billed.",
   "step": 9,
   "url": "/admin/purchasing/orders/6"
  }
 ],
