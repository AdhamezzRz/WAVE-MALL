   "end": 8.55,
   "text": "Record a brand you are talking to: what they want, who to call and the next step.",
   "step": 0,
   "url": "",
   "intro": true
  },
  {
   "start": 8.56,
   "end": 15.35,
   "text": "Leads are every brand you are talking to, from the first call to the signed lease.",
   "step": 1,
   "url": "/admin/leads"
  },
  {
   "start": 15.35,
   "end": 22.34,
   "text": "Ready-made views show your leads, the hot ones, deals closing soon and follow-ups that are late.",
   "step": 2,
   "url": "/admin/leads"
  },
  {
   "start": 22.34,
   "end": 26.41,
   "text": "To add one, choose New lead.",
   "step": 3,
   "url": "/admin/leads/new"
  },
  {
   "start": 26.41,
   "end": 32.14,
   "text": "Name the lead, usually the brand and the concept.",
