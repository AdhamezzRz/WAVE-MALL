 "cues": [
  {
   "start": 0.02,
   "end": 9.33,
   "text": "Pay what is due by card, mobile wallet or at a payment outlet, and get your receipt straight away.",
   "step": 0,
   "url": "",
   "intro": true
  },
  {
   "start": 9.33,
   "end": 14.51,
   "text": "When something is due, the home page of your portal says so.",
   "step": 1,
   "url": "/portal"
  },
  {
   "start": 14.51,
   "end": 18.11,
   "text": "Your balance shows what is due now.",
   "step": 2,
   "url": "/portal"
  },
  {
   "start": 18.11,
   "end": 21.17,
   "text": "Choose Pay now.",
   "step": 3,
   "url": "/portal/invoices/357#pay"
  },
  {
   "start": 21.17,
   "end": 27.73,
   "text": "The invoice shows what it is for, the due date and what is still outstanding.",
   "step": 4,
   "url": "/portal/invoices/357#pay"
  },
  {
   "start": 27.73,
   "end": 36.38,
   "text": "Choose how to pay: a bank card, a mobile wallet, or cash at a payment outlet with a reference number.",
   "step": 5,
   "url": "/portal/invoices/357#pay"
  },
  {
   "start": 36.38,
   "end": 41.89,
   "text": "Pay. You go to the secure payment page of the bank.",
   "step": 6,
   "url": "/pay/sandbox/XE2WGrVfJIbh4uavpbex67TjKAG-qg4aS5O_kxCYg8E?lang=en"
  },
  {
   "start": 41.89,
   "end": 51.67,
   "text": "Check the amount and the invoice, then confirm. In this practice office the bank page is a test page, so no money moves.",
   "step": 7,
   "url": "/pay/sandbox/XE2WGrVfJIbh4uavpbex67TjKAG-qg4aS5O_kxCYg8E?lang=en"
  },
  {
   "start": 54.46,
   "end": 60.63,
   "text": "Payment received. The receipt number is here, and a copy goes to your email.",
   "step": 9,
   "url": "/pay/result/XE2WGrVfJIbh4uavpbex67TjKAG-qg4aS5O_kxCYg8E?lang=en"
  },
  {
   "start": 60.63,
   "end": 68.48,
   "text": "Back in the portal, the invoice is paid and the receipt is ready to download any time.",
   "step": 10,
   "url": "/portal/invoices/357"
  }
 ],
