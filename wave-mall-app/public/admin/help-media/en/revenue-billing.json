  {
   "start": 0.06,
   "end": 8.6,
   "text": "See what is open, overdue and coming up, filter by tenant or lease, and open an invoice.",
   "step": 0,
   "url": "",
   "intro": true
  },
  {
   "start": 8.6,
   "end": 15.17,
   "text": "Invoices are created from each lease's rent schedule. You never type them in by hand.",
   "step": 1,
   "url": "/admin/billing"
  },
  {
   "start": 15.17,
   "end": 21.83,
   "text": "The totals show what is open, what is overdue and what was collected this month.",
   "step": 2,
   "url": "/admin/billing"
  },
  {
   "start": 21.83,
   "end": 27.59,
   "text": "The tabs split the invoices. Here are the overdue ones.",
