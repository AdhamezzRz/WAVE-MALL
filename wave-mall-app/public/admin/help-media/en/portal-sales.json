 "title": "Reporting your monthly sales",
 "duration": 47.56,
 "cues": [
  {
   "start": 0.01,
   "end": 10.09,
   "text": "Send your sales for the month from the portal. If your lease has turnover rent, it is worked out from them.",
   "step": 0,
   "url": "",
   "intro": true
  },
  {
   "start": 10.09,
   "end": 13.36,
   "text": "Each month, report your store's sales here.",
   "step": 1,
   "url": "/portal/sales"
  },
  {
   "start": 13.36,
   "end": 17.99,
   "text": "The portal tells you which months are still to report.",
   "step": 2,
   "url": "/portal/sales"
  },
  {
   "start": 17.99,
   "end": 21.05,
   "text": "The month is chosen for you.",
   "step": 3,
   "url": "/portal/sales"
  },
  {
   "start": 21.05,
   "end": 24.11,
   "text": "Enter the gross sales, before VAT.",
   "step": 4,
   "url": "/portal/sales"
  },
  {
   "start": 24.11,
   "end": 28.33,
   "text": "Then the returns. Net sales are gross sales minus returns.",
   "step": 5,
   "url": "/portal/sales"
  },
  {
   "start": 28.33,
   "end": 32.08,
   "text": "And the number of receipts, if you have it.",
   "step": 6,
   "url": "/portal/sales"
  },
  {
   "start": 32.08,
   "end": 34.98,
   "text": "Submit sales.",
   "step": 7,
   "url": "/portal/sales"
  },
  {
   "start": 34.98,
   "end": 43.37,
