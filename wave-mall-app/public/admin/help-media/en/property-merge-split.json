{
 "id": "property-merge-split",
 "lang": "en",
 "title": "Merging and splitting units",
 "duration": 71.6,
 "cues": [
  {
   "start": 0.02,
   "end": 8.56,
   "text": "Join neighbouring shops into one larger unit for a big brand, or divide one into smaller units.",
   "step": 0,
   "url": "",
   "intro": true
  },
  {
   "start": 8.56,
   "end": 14.93,
   "text": "A brand needs more space than one shop? Join two neighbours. Open the first one.",
   "step": 1,
   "url": "/admin/units"
  },
  {
   "start": 17.8,
   "end": 22.58,
   "text": "Merge or split is at the bottom of the unit page.",
   "step": 3,
   "url": "/admin/units/14"
  },
  {
   "start": 22.58,
   "end": 26.97,
   "text": "Choose Merge with other units.",
   "step": 4,
   "url": "/admin/units/14"
  },
  {
   "start": 26.97,
   "end": 31.75,
   "text": "Tick the neighbour that joins it.",
   "step": 5,
   "url": "/admin/units/14"
  },
  {
   "start": 31.75,
   "end": 38.75,
   "text": "Give the new unit a code, or leave it empty to make one from the old codes.",
   "step": 6,
   "url": "/admin/units/14"
  },
  {
   "start": 38.75,
   "end": 41.79,
   "text": "Merge.",
   "step": 7,
   "url": "/admin/units/24"
  },
  {
   "start": 41.79,
   "end": 49.29,
   "text": "One unit with the combined area and list rent. The old units are kept in its history.",
   "step": 8,
   "url": "/admin/units/24"
  },
  {
   "start": 49.29,
   "end": 53.13,
   "text": "The plan redraws the shop as one space.",
   "step": 9,
   "url": "/admin/units/24"
  },
  {
   "start": 54.05,
   "end": 58.96,
   "text": "Splitting works the other way round.",
   "step": 11,
   "url": "/admin/units/24"
  },
  {
   "start": 58.96,
   "end": 67.41,
   "text": "The parts are suggested half and half. Change the codes and areas, add a third part if needed, and split.",
   "step": 12,
   "url": "/admin/units/24"
  }
 ],
