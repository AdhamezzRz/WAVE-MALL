 "title": "Service charge: budget, costs and year-end",
 "duration": 72.36,
 "cues": [
  {
   "start": 0.03,
   "end": 8.59,
   "text": "Plan the year's budget, record the real costs, and settle the difference with each tenant at year-end.",
   "step": 0,
   "url": "",
   "intro": true
  },
  {
   "start": 8.59,
   "end": 13.97,
   "text": "Service charge shares the cost of running the mall among the tenants.",
   "step": 1,
   "url": "/admin/service-charge"
  },
  {
   "start": 13.97,
   "end": 19.78,
   "text": "The budget, the costs so far, what was billed and the expected balance.",
   "step": 2,
   "url": "/admin/service-charge"
  },
  {
   "start": 19.78,
   "end": 25.49,
   "text": "The budget sets the cost of each category for the year.",
   "step": 3,
   "url": "/admin/service-charge/budget?year=2026"
  },
  {
   "start": 25.49,
   "end": 28.35,
   "text": "Choose next year.",
   "step": 4,
   "url": "/admin/service-charge/budget?year=2027"
  },
  {
   "start": 28.38,
   "end": 33.07,
   "text": "Start from last year with an uplift, then adjust any line.",
   "step": 6,
   "url": "/admin/service-charge/budget?year=2027"
  },
  {
   "start": 33.07,
   "end": 36.31,
   "text": "Choose Start from last year.",
   "step": 7,
   "url": "/admin/service-charge/budget?year=2027"
  },
  {
   "start": 36.31,
   "end": 40.76,
   "text": "Through the year, record the real costs under Actual costs.",
   "step": 8,
   "url": "/admin/service-charge/actuals"
  },
  {
   "start": 40.76,
   "end": 45.4,
   "text": "Choose the month and the category, and the amount.",
   "step": 9,
   "url": "/admin/service-charge/actuals"
  },
  {
   "start": 48.53,
   "end": 55.35,
   "text": "Choose Add cost. You can also import them, or bring them from the accounts.",
   "step": 11,
   "url": "/admin/service-charge/actuals?year=2026"
  },
  {
   "start": 55.35,
   "end": 61.5,
   "text": "At year-end, Reconciliation compares what each tenant paid with their real share.",
   "step": 12,
   "url": "/admin/service-charge/reconciliation?year=2026"
  },
  {
   "start": 61.5,
   "end": 67.71,
   "text": "Each tenant gets a statement to print: a refund, or a balance to pay.",
   "step": 13,
   "url": "/admin/service-charge/reconciliation?year=2026"
  }
 ],
