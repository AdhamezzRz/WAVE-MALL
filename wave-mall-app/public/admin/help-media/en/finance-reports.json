   "text": "Open the financial statements for any period, compare with last year or the budget, and export them.",
   "step": 0,
   "url": "",
   "intro": true
  },
  {
   "start": 8.6,
   "end": 13.23,
   "text": "All the financial reports are in one place, under Reports.",
   "step": 1,
   "url": "/admin/accounting/reports"
  },
  {
   "start": 13.23,
   "end": 21.82,
   "text": "Profit and loss, balance sheet, cash flow, trial balance, the general ledger, VAT and the ageing of what is owed.",
   "step": 2,
   "url": "/admin/accounting/reports"
  },
  {
   "start": 21.82,
   "end": 25.85,
   "text": "Open the profit and loss.",
