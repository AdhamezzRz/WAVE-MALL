{
 "id": "attendance-staff-clock",
 "lang": "ar",
 "title": "تسجيل الحضور من هاتفك",
 "duration": 84.48,
 "cues": [
  {
   "start": 0.02,
   "end": 8.55,
   "text": "كيف يدخل الموظف إلى تطبيق الموظفين، ويسجّل حضوره داخل دائرة المول، ويأخذ استراحة، ويسجّل انصرافه.",
   "step": 0,
   "url": "",
   "intro": true
  },
  {
   "start": 8.55,
   "end": 16.98,
   "text": "يسجّل الموظفون حضورهم بتطبيق الموظفين من هواتفهم، وتعطي الموارد البشرية كل شخص رمزًا ورقمًا سريًا من ستة أرقام.",
   "step": 1,
   "url": "/staff/login"
  },
  {
   "start": 16.98,
   "end": 20.16,
   "text": "اكتب رمز الموظف.",
   "step": 2,
   "url": "/staff/login"
  },
  {
   "start": 20.16,
   "end": 23.11,
   "text": "ثم الرقم السري.",
   "step": 3,
   "url": "/staff/login"
  },
  {
   "start": 23.11,
   "end": 28.46,
   "text": "اضغط «تسجيل الدخول»، وأول هاتف تدخل منه يصبح هاتفك.",
   "step": 4,
   "url": "/staff/consent"
  },
  {
   "start": 28.46,
   "end": 35.34,
   "text": "في المرة الأولى، يشرح ما يُسجَّل: موقعك فقط عند التسجيل وأثناء وجودك في العمل.",
   "step": 5,
   "url": "/staff/consent"
  },
  {
   "start": 35.34,
   "end": 38.35,
   "text": "اختر «فهمت وأوافق».",
   "step": 6,
   "url": "/staff"
  },
  {
   "start": 38.35,
   "end": 44.36,
   "text": "يحدد التطبيق موقعك ويعرض بعدك عن المول، وداخل الدائرة يصبح الزر جاهزًا.",
   "step": 7,
   "url": "/staff"
  },
  {
   "start": 44.36,
   "end": 52.06,
   "text": "اضغط «تسجيل الحضور»، ويتحقق المكتب من المسافة والإشارة ومن أن هذا هاتفك.",
   "step": 8,
   "url": "/staff"
  },
  {
   "start": 52.09,
   "end": 58.51,
   "text": "سُجّل حضورك. اترك التطبيق مفتوحًا أثناء العمل، فهو يحدّث موقعك كل بضع دقائق.",
   "step": 10,
   "url": "/staff"
  },
  {
   "start": 58.51,
   "end": 64.88,
   "text": "ذاهب إلى استراحة؟ اضغط «بدء استراحة»، وأنهِها عند عودتك.",
   "step": 11,
   "url": "/staff"
  },
  {
   "start": 64.91,
   "end": 69.09,
   "text": "اضغط «إنهاء الاستراحة».",
   "step": 13,
   "url": "/staff"
  },
  {
   "start": 69.11,
   "end": 74.22,
   "text": "وفي نهاية الوردية، اضغط «تسجيل الانصراف» وأنت داخل الدائرة أيضًا.",
   "step": 15,
   "url": "/staff"
  },
  {
   "start": 74.22,
   "end": 80.2,
   "text": "ويعرض «اليوم» كل تسجيلاتك، وفي الأسفل «شهري» و«تصحيح وقت» إن نسيت تسجيلًا.",
   "step": 16,
   "url": "/staff"
  }
 ],
