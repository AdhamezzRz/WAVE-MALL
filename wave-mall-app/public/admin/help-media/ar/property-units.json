{
 "id": "property-units",
 "lang": "ar",
 "title": "إيجاد وحدة وحجزها مؤقتًا",
 "duration": 78.64,
 "cues": [
  {
   "start": 0.02,
   "end": 8.1,
   "text": "اقرأ مخطط المول، وافتح الوحدة لترى مساحتها وإيجارها المعلن، واحجزها مؤقتًا لعلامة تتفاوض معها.",
   "step": 0,
   "url": "",
   "intro": true
  },
  {
   "start": 8.1,
   "end": 13.05,
   "text": "تعرض «الوحدات والمخطط» كل متاجر المول، على المخطط وفي قائمة.",
   "step": 1,
   "url": "/admin/units"
  },
  {
   "start": 13.05,
   "end": 18.75,
   "text": "في الأعلى: عدد الوحدات المتاحة والمحجوزة مؤقتًا والمحجوزة والمؤجرة، مع مساحتها.",
   "step": 2,
   "url": "/admin/units"
  },
  {
   "start": 18.75,
   "end": 24.29,
   "text": "على المخطط لكل حالة لون، فتظهر المساحات المتاحة من النظرة الأولى.",
   "step": 3,
   "url": "/admin/units"
  },
  {
   "start": 24.29,
   "end": 36.98,
   "text": "مرّر المؤشر على أي متجر لترى رمزه وحالته ومساحته.",
   "step": 4,
   "url": "/admin/units"
  },
  {
   "start": 36.98,
   "end": 42.63,
   "text": "اضغط على المتجر في المخطط أو في القائمة لتفتحه.",
   "step": 5,
   "url": "/admin/units/9"
  },
  {
   "start": 42.63,
   "end": 48.21,
   "text": "تعرض صفحة الوحدة حالتها ومساحتها الداخلية والتراس، والإيجار المعلن شهريًا وسنويًا.",
   "step": 6,
   "url": "/admin/units/9"
  },
  {
   "start": 48.21,
   "end": 54.18,
   "text": "يحدد «الموقع» المتجر على المخطط، وتحته مستنداته وأوامر العمل والفرص المهتمة والعروض.",
   "step": 7,
   "url": "/admin/units/9"
  },
  {
   "start": 54.18,
   "end": 60.59,
   "text": "لتحتفظ بها لعلامة أثناء التفاوض، اختر الفرصة في «احجز هذه الوحدة مؤقتًا».",
   "step": 8,
   "url": "/admin/units/9"
  },
  {
   "start": 60.59,
   "end": 65.49,
   "text": "حدد عدد الأيام، فالحجز ينتهي تلقائيًا ولا تبقى الوحدات محجوزة بالخطأ.",
   "step": 9,
   "url": "/admin/units/9"
  },
  {
   "start": 65.49,
   "end": 68.41,
   "text": "أكّد الحجز.",
   "step": 10,
   "url": "/admin/units/9"
  },
  {
   "start": 68.41,
   "end": 74.41,
   "text": "أصبحت الوحدة محجوزة مؤقتًا لتلك العلامة، على المخطط ولكل من في المكتب.",
   "step": 11,
   "url": "/admin/units/9"
  }
 ],
