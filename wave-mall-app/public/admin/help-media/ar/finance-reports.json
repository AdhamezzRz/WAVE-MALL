 "cues": [
  {
   "start": 0.1,
   "end": 6.9,
   "text": "افتح القوائم المالية لأي فترة، وقارنها بالعام الماضي أو بالميزانية، وصدّرها.",
   "step": 0,
   "url": "",
   "intro": true
  },
  {
   "start": 6.9,
   "end": 11.46,
   "text": "كل التقارير المالية في مكان واحد، تحت «التقارير».",
   "step": 1,
   "url": "/admin/accounting/reports"
  },
  {
   "start": 11.46,
   "end": 18.04,
   "text": "قائمة الدخل، والمركز المالي، والتدفقات النقدية، وميزان المراجعة، ودفتر الأستاذ، والضريبة، وأعمار الديون.",
   "step": 2,
   "url": "/admin/accounting/reports"
  },
  {
   "start": 18.04,
   "end": 21.62,
   "text": "افتح قائمة الدخل.",
   "step": 3,
   "url": "/admin/accounting/reports/pl"
  },
  {
   "start": 21.62,
   "end": 26.95,
   "text": "اختر الفترة، وهي تبدأ من أول يوم في السنة المالية.",
   "step": 4,
   "url": "/admin/accounting/reports/pl"
  },
  {
   "start": 26.95,
   "end": 30.63,
   "text": "قارنها بالميزانية، أو بالعام الماضي.",
   "step": 5,
   "url": "/admin/accounting/reports/pl?from=2026-01-01&to=2026-11-05&view=summary&compare=budget"
  },
  {
   "start": 31.83,
   "end": 37.07,
   "text": "كل سطر يفتح الحساب، وصولًا إلى القيود التي وراء الرقم.",
   "step": 7,
   "url": "/admin/accounting/reports/pl?from=2026-01-01&to=2026-11-05&view=summary&compare=budget"
  },
  {
   "start": 37.07,
   "end": 41.11,
   "text": "أو اعرضها حسب الشهر لترى الاتجاه.",
   "step": 8,
   "url": "/admin/accounting/reports/pl?from=2026-01-01&to=2026-11-05&view=monthly&compare=budget"
  },
  {
   "start": 42.31,
   "end": 47.47,
   "text": "اطبعها، أو صدّرها إلى جدول بيانات للمراجع أو للمالك.",
   "step": 10,
   "url": "/admin/accounting/reports/pl?from=2026-01-01&to=2026-11-05&view=monthly&compare=budget"
  },
  {
   "start": 47.47,
