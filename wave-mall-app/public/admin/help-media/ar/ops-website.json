   "url": "",
   "intro": true
  },
  {
   "start": 6.83,
   "end": 12.11,
   "text": "من قسم الموقع تُحدّث الموقع العام: دليل المتاجر والفعاليات والعروض.",
   "step": 1,
   "url": "/admin/website"
  },
  {
   "start": 12.11,
   "end": 15.7,
   "text": "افتح متجرًا.",
