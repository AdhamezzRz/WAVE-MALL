   "url": "/admin/website/stores/2"
  },
  {
   "start": 15.7,
   "end": 20.02,
   "text": "بياناته باللغتين العربية والإنجليزية: الاسم والشعار والوصف والفئة.",
   "step": 3,
   "url": "/admin/website/stores/2"
  },
  {
   "start": 20.02,
   "end": 24.07,
   "text": "أضف مواعيد العمل.",
