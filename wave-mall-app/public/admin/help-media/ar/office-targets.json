 "title": "تحديد المستهدفات الشهرية للفريق",
 "duration": 56.64,
 "cues": [
  {
   "start": 0.03,
   "end": 8.12,
   "text": "تابع أداء كل شخص هذا الشهر، وحدد مستهدفاته من الفرص والمعاينات والمساحة الموقّعة والإيجار.",
   "step": 0,
   "url": "",
   "intro": true
  },
  {
   "start": 8.12,
   "end": 12.86,
   "text": "تعرض صفحة الفريق والمستهدفات أداء كل شخص هذا الشهر.",
   "step": 1,
   "url": "/admin/team"
  },
  {
   "start": 12.86,
   "end": 19.38,
   "text": "يعرض «فريق التأجير» كل شخص بدوره وصفقاته المفتوحة والموقّعة وآخر تسجيل دخول له.",
   "step": 2,
   "url": "/admin/team"
  },
  {
   "start": 19.38,
   "end": 23.66,
   "text": "وفي الأسفل مستهدفات هذا الشهر، صف لكل شخص.",
   "step": 3,
   "url": "/admin/team"
  },
  {
   "start": 23.66,
   "end": 26.48,
   "text": "أدخل عدد الفرص الجديدة، وعدد المعاينات،",
   "step": 4,
   "url": "/admin/team"
  },
  {
   "start": 29.93,
   "end": 34.41,
   "text": "والمساحة المطلوب توقيعها بالمتر المربع، والإيجار السنوي المستهدف.",
   "step": 6,
   "url": "/admin/team"
  },
  {
   "start": 37.9,
   "end": 45.45,
   "text": "احفظ المستهدفات، وتقيس صفحة التقارير أداء كل شخص مقابلها في «الفريق هذا الشهر».",
   "step": 8,
   "url": "/admin/team?period=2026-11#targets"
  },
  {
   "start": 45.45,
   "end": 51.74,
   "text": "ولتغيير ما يمكن لشخص رؤيته أو فعله، انتقل إلى المستخدمين والصلاحيات.",
   "step": 9,
   "url": "/admin/team?period=2026-11#targets"
  }
 ],
