 "title": "غرامات التأخير وإعدام الدين",
 "duration": 56.24,
 "cues": [
  {
   "start": 0.06,
   "end": 6.85,
   "text": "احتسب غرامة تأخير، واطلب الموافقة على إعدام الدين الذي لن يُسدَّد.",
   "step": 0,
   "url": "",
   "intro": true
  },
  {
   "start": 6.85,
   "end": 11.51,
   "text": "كل ما يخص تحصيل الفاتورة موجود في الفاتورة نفسها.",
   "step": 1,
   "url": "/admin/billing?status=overdue"
  },
  {
   "start": 15.18,
   "end": 21.35,
   "text": "من «التحصيل» يمكنك إرسال تذكير، أو احتساب غرامة التأخير المحددة في الإعدادات.",
   "step": 3,
   "url": "/admin/invoices/265"
  },
  {
   "start": 21.35,
   "end": 28.01,
   "text": "إن كان المبلغ لن يُسدَّد أبدًا، اختر «إعدام الدين».",
   "step": 4,
   "url": "/admin/invoices/265"
  },
  {
   "start": 28.01,
   "end": 33.44,
   "text": "أدخل المبلغ والسبب.",
   "step": 5,
   "url": "/admin/invoices/265"
  },
  {
   "start": 33.44,
   "end": 39.78,
   "text": "يحتاج إعدام الدين دائمًا إلى موافقة مدير، لذا اختر «اطلب الموافقة».",
   "step": 6,
   "url": "/admin/invoices/265"
  },
  {
   "start": 39.78,
   "end": 45.43,
   "text": "يذهب الطلب إلى «الموافقات والمهام»، وبعد الموافقة يُعدَم الدين وتُحدَّث الحسابات.",
   "step": 7,
   "url": "/admin/invoices/265"
  },
  {
   "start": 45.43,
   "end": 51.6,
   "text": "وتجد كل دين معدوم، ومن وافق عليه، في «الديون المعدومة» داخل صفحة التحصيل.",
   "step": 8,
   "url": "/admin/invoices/265"
  }
 ],
